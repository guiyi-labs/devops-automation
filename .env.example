# ============================================================
# EasyOps 环境变量示例
# 复制为 .env 并按需修改；仓库不保存任何真实凭据。
# 本地开发可保留默认值；部署到真实环境前必须修改 ⚠️ 项。
# ============================================================

# 环境标识: development | production
APP_ENV=development

# ---------- 数据库 ----------
# DATABASE_URL 存在时优先于 MySQL 分解字段（测试可填 sqlite:///test.db）
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456          # ⚠️ 生产环境必须修改
MYSQL_DB=easyops

# ---------- Redis / Celery ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------- JWT ----------
# 生产环境必填：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=                         # ⚠️ 生产环境必填，禁止使用开发默认值

# ---------- 管理员初始化 ----------
# init-admin 一次性 bootstrap 使用的初始密码
INITIAL_ADMIN_PASSWORD=admin123     # ⚠️ 生产环境必须修改

# ---------- SSH 凭据加密 ----------
# 生产环境必填：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 更换该值会导致已加密的账密/私钥无法解密，请妥善保管并备份。
CREDENTIAL_ENCRYPTION_KEY=          # ⚠️ 生产环境必填

# ---------- CORS ----------
# 逗号分隔的允许来源；禁止使用 * 且同时开启 credentials
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------- SSH 主机信任 ----------
# false：未登记 host key 指纹的主机默认拒绝连接（推荐生产保持 false）
# true ：允许连接未登记指纹的主机（仅限本地开发演示）
SSH_ALLOW_UNVERIFIED_HOST_KEY=false